Version 1;
Input test;

TypeAlias file PATH{path} | URI{uri};

Export Function describe(file f)
  Match f
    When PATH{p} Then "local {p}"
    When URI{u} Then "remote {u}";

Export Function remote_text([uri] us) For u In us: List "{u}";

Olive Run ok With ok =
  describe(std::string::to_path_or_uri("gs://bucket/x")) != ""
  && std::path_or_uri::to_string(PATH{'/a'}) == "/a";
