Version 1;
Input test;

Function describe(PATH{path} | URI{scheme = string, host = string, name = string} f)
  Match f
    When PATH{p} Then "local {p}"
    When URI * Then "{scheme} bucket {host} object {name}";

Function round_trip(string s) std::path_or_uri::to_string(std::string::to_path_or_uri(s)) == s;

Olive Run ok With ok =
  describe(std::string::to_path_or_uri("gs://bucket/a/b.bam")) == "gs bucket bucket object a/b.bam"
  && std::string::to_path_or_uri("gs://bucket/a b#1.bam") == URI{scheme = "gs", host = "bucket", name = "a b#1.bam"}
  && describe(std::string::to_path_or_uri("/data/a/b.bam")) == "local /data/a/b.bam"
  && std::string::to_path_or_uri("relative/x") == PATH{'relative/x'}
  && round_trip("gs://bucket/a b#1?x%20.bam")
  && round_trip("s3://bucket//a/dir/")
  && round_trip("/data/a/b.bam")
  && std::path_or_uri::file(std::string::to_path_or_uri("gs://bucket/a/b.bam")) == "b.bam"
  && std::path_or_uri::file(std::string::to_path_or_uri("gs://bucket/a/dir/")) == ""
  && std::path_or_uri::to_string(URI{scheme = "gs", host = "bucket", name = "a/b.bam"}) == "gs://bucket/a/b.bam"
  && std::path_or_uri::file(PATH{'/data/a/b.bam'}) == "b.bam"
  && std::path_or_uri::to_path(PATH{'/data/a/b.bam'}) == `'/data/a/b.bam'`
  && std::path_or_uri::to_path(std::string::to_path_or_uri("gs://bucket/a/b.bam")) == ``
  && std::path_or_uri::to_uri(std::string::to_path_or_uri("gs://bucket/a/b.bam")) == `{scheme = "gs", host = "bucket", name = "a/b.bam"}`
  && std::path_or_uri::to_uri(PATH{'/data/a/b.bam'}) == ``;
