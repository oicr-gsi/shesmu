Version 1;
Input test;

Function location_text(PATH{path} | URI{uri} location)
  Match location
    When PATH{p} Then "{p}"
    When URI{u} Then "{u}";

Function bucket(uri u) std::uri::host(u) Default "";

Olive Run ok With ok = Begin
  remote = std::uri::parse("gs://bucket/a/b.bam") Default std::uri::from_path('/data');
  Return location_text(URI{remote}) == "gs://bucket/a/b.bam"
    && location_text(PATH{'/data/x'}) == "/data/x"
    && bucket(remote) == "bucket"
    && std::uri::scheme(remote) == `"gs"`
    && std::uri::path(remote) == `'/a/b.bam'`
    && std::uri::resolve(remote, "c.bam") == std::uri::parse("gs://bucket/a/c.bam")
    && "{std::uri::parse("gs://bucket/a%20b%231.bam") Default remote}" == "gs://bucket/a%20b%231.bam"
    && std::uri::host(std::uri::parse("https://user:pw@Example.com:8443/x") Default remote) == `"Example.com"`
    && std::uri::host(std::uri::parse("gs://My_Bucket/x") Default remote) == `"My_Bucket"`
    && "x" + (std::uri::parse("gs://bucket/a%20b") Default remote) == "xgs://bucket/a%20b"
    && (For {s As string = u} In [{u = std::uri::parse("gs://bucket/a%20b") Default remote}]: Sort s First s Default "") == "gs://bucket/a%20b"
    && std::uri::parse("{std::uri::parse("gs://bucket/a%20b") Default remote}") == std::uri::parse("gs://bucket/a%20b")
    && ("gs://bucket/a b" As json) As uri == std::uri::parse("gs://bucket/a%20b")
    && (std::uri::path(std::uri::parse("gs://bucket/a%00x") Default remote) Default '/none') == '/none';
  End;
